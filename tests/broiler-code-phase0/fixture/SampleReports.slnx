<Solution>
  <!--
    Hand-authored. This fixture stands in for a user workspace, so it is NOT
    generated by eng/solutions.json and must never be added to that manifest:
    it fails to compile by design.
  -->
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path="Directory.Build.props" />
    <File Path="Directory.Build.targets" />
    <File Path="NuGet.config" />
    <File Path="global.json" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/SampleReports.Core/SampleReports.Core.csproj" />
    <Project Path="src/SampleReports.App/SampleReports.App.csproj" />
  </Folder>
  <Folder Name="/targets/">
    <Project Path="targets/SampleReports.Android/SampleReports.Android.csproj" />
    <Project Path="targets/SampleReports.Web/SampleReports.Web.csproj" />
  </Folder>
</Solution>
