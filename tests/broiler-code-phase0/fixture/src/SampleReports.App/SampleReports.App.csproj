<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SampleReports.App</RootNamespace>
    <AssemblyName>SampleReports.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SampleReports.Core\SampleReports.Core.csproj" />
  </ItemGroup>

  <!--
    The intentional cross-project error lives in ReportRunner.Broken.cs. Setting
    FixtureCorrected=true swaps in the fixed call site instead, which is how the
    Phase 4/5 "corrected fixture produces verified artifacts" gate is reached
    without editing tracked source. Both files declare the same type, so exactly
    one of them must be compiled.
  -->
  <ItemGroup>
    <Compile Remove="Reporting\ReportRunner.Broken.cs" Condition="'$(FixtureCorrected)' == 'true'" />
    <Compile Remove="Reporting\ReportRunner.Corrected.cs" Condition="'$(FixtureCorrected)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- An editable non-code configuration input that reaches the output. -->
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
