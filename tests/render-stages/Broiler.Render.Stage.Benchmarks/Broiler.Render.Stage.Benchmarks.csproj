<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <RootNamespace>Broiler.Render.Stage.Benchmarks</RootNamespace>
    <AssemblyName>Broiler.Render.Stage.Benchmarks</AssemblyName>
    <!--
      Deliberately NOT setting ServerGarbageCollection. Multithreading item #19 is the open question
      of whether Server GC helps a headless render, and a benchmark project that pinned one mode
      would be unable to answer it: GCSettings.IsServerGC is fixed at runtime start. The mode is
      chosen per run through DOTNET_gcServer, which is what the `gc-config` mode reports and compares.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <!--
    The item-#3 mode (the graphics-raster-scaling switch) sets Broiler.Graphics's raster thread budget,
    which arrived with `patches/0127-graphics-raster-band-parallelism.patch`. That patch could not
    be pushed to the submodule remote (403, see patches/README.md), so the pinned pointer does not
    carry it and a clean checkout would fail to compile these two files.

    Rather than leave the project broken until a maintainer applies the patch, the mode compiles
    only when the submodule tree actually has the partitioner. The probe is the source file itself
    because that is the exact thing being depended on — a version string or a date would be a proxy
    for it, and would go stale. Once the patch lands upstream and the pointer is bumped, the file is
    there and this condition simply stops doing anything.
  -->
  <PropertyGroup>
    <BroilerGraphicsRasterParallelism Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Broiler.Graphics\Broiler.Graphics\Rendering\BRasterParallelism.cs')">true</BroilerGraphicsRasterParallelism>
    <DefineConstants Condition="'$(BroilerGraphicsRasterParallelism)' == 'true'">$(DefineConstants);BROILER_GRAPHICS_RASTER_PARALLELISM</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(BroilerGraphicsRasterParallelism)' != 'true'">
    <Compile Remove="GraphicsRasterScaling.cs" />
    <Compile Remove="GraphicsSceneCorpus.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The headless render stack, entered at HtmlRender / HtmlContainer. -->
    <ProjectReference Include="..\..\..\Broiler.HTML\Source\Broiler.HTML.Image\Broiler.HTML.Image.csproj" />
    <!--
      Not referenced in source, and required anyway. `CompatProvider` resolves the default rendering
      adapter by Assembly.Load at first use, so without this the very first `new BBitmap(...)` throws
      FileNotFoundException at run time rather than failing the build. Broiler.Wpt carries the same
      reference for the same reason.
    -->
    <ProjectReference Include="..\..\..\Broiler.HTML\Source\Broiler.HTML.Image.Compat\Broiler.HTML.Image.Compat.csproj" />
    <ProjectReference Include="..\..\..\Broiler.HTML\Source\Broiler.HTML.Orchestration\Broiler.HTML.Orchestration.csproj" />
    <!-- The cascade, driven directly rather than through a render, for CascadeBenchmarks. -->
    <ProjectReference Include="..\..\..\Broiler.CSS\Broiler.CSS.Dom\Broiler.CSS.Dom.csproj" />
    <ProjectReference Include="..\..\..\Broiler.DOM\Broiler.Dom.Html\Broiler.Dom.Html.csproj" />
    <!-- BColor, and the image encode formats the decode benchmark builds its fixtures with. -->
    <ProjectReference Include="..\..\..\Broiler.Graphics\Broiler.Graphics\Broiler.Graphics.csproj" />
    <!-- For the js-context-scaling mode: whether two JSContexts on two threads actually run at
         the same time, which is the question multithreading item #18 (Web Workers) turns on. -->
    <ProjectReference Include="..\..\..\Broiler.JS\Broiler.JS\Broiler.JavaScript.All\Broiler.JavaScript.All.csproj" />
    <ProjectReference Include="..\..\..\Broiler.Media\Broiler.Media.Image\Broiler.Media.Image.csproj" />
    <!--
      The decode-scaling mode sets `ImageDecodeParallelism.MaxDegreeOfParallelism`, which is internal
      to the managed codecs (see the InternalsVisibleTo there). Referenced explicitly rather than
      relied on transitively, because that is the assembly this project actually names in source.
    -->
    <ProjectReference Include="..\..\..\Broiler.Media\Broiler.Media.Image.Managed\Broiler.Media.Image.Managed.csproj" />
  </ItemGroup>

</Project>
