<Project>
  <!--
    Central Package Management: every PackageReference under src/ names a package only, and its
    version lives here. Packages a component publishes in lock-step share a family property; a
    package pinned apart from its family keeps its own literal version.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <BroilerHtmlVersion>0.1.0-preview.27</BroilerHtmlVersion>
    <BroilerHtmlBridgeVersion>0.1.0-preview.28-http2.6</BroilerHtmlBridgeVersion>
    <BroilerUiVersion>0.1.0-preview.19</BroilerUiVersion>
    <BroilerInputVersion>0.1.0-preview.5</BroilerInputVersion>
    <BroilerGraphicsVersion>0.1.0-preview.11</BroilerGraphicsVersion>
    <BroilerHostingVersion>0.1.0-preview.8</BroilerHostingVersion>
    <!-- Printing: HtmlContainer.PageSize is in Broiler.HTML 0.1.0-preview.29, the print dialog in
         Broiler.UI 0.1.0-preview.21, the page model in Broiler.Graphics 0.1.0-preview.13, the print
         hosts in Broiler.Hosting 0.1.0-preview.10 and the CUPS spool writer in Broiler.Documents.Pdf
         0.1.0-preview.23. Properties, so a build against local packs can name them. -->
    <BroilerHtmlPackageVersion Condition="'$(BroilerHtmlPackageVersion)' == ''">0.1.0-preview.29</BroilerHtmlPackageVersion>
    <BroilerUiPackageVersion Condition="'$(BroilerUiPackageVersion)' == ''">0.1.0-preview.21</BroilerUiPackageVersion>
    <BroilerGraphicsPackageVersion Condition="'$(BroilerGraphicsPackageVersion)' == ''">0.1.0-preview.13</BroilerGraphicsPackageVersion>
    <BroilerHostingPackageVersion Condition="'$(BroilerHostingPackageVersion)' == ''">0.1.0-preview.10</BroilerHostingPackageVersion>
    <!-- Unchanged at 0.1.0-preview.28; a property only so a local verification build can name a pack. -->
    <BroilerHtmlBridgePackageVersion Condition="'$(BroilerHtmlBridgePackageVersion)' == ''">0.1.0-preview.28</BroilerHtmlBridgePackageVersion>
    <BroilerDocumentsPackageVersion Condition="'$(BroilerDocumentsPackageVersion)' == ''">0.1.0-preview.23</BroilerDocumentsPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Broiler.HTML.Graphics" Version="$(BroilerHtmlPackageVersion)" />
    <PackageVersion Include="Broiler.HTML.Image" Version="$(BroilerHtmlPackageVersion)" />
    <PackageVersion Include="Broiler.HtmlBridge.Core" Version="$(BroilerHtmlBridgePackageVersion)" />
    <PackageVersion Include="Broiler.HtmlBridge.Dom" Version="$(BroilerHtmlBridgePackageVersion)" />
    <PackageVersion Include="Broiler.HtmlBridge.Scripting" Version="$(BroilerHtmlBridgePackageVersion)" />
    <PackageVersion Include="Broiler.HtmlBridge.Scripting.Vm" Version="$(BroilerHtmlBridgeVersion)" />
    <PackageVersion Include="Broiler.CSS.Dom" Version="0.1.0-preview.17" />
    <PackageVersion Include="Broiler.Dom.Html" Version="0.1.0-preview.14" />
    <PackageVersion Include="Broiler.Layout" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.Net" Version="0.1.0-preview.3" />
    <PackageVersion Include="Broiler.Hosting.Windows" Version="$(BroilerHostingPackageVersion)" />
    <PackageVersion Include="Broiler.Hosting.Linux" Version="$(BroilerHostingPackageVersion)" />
    <PackageVersion Include="Broiler.Hosting.Android" Version="$(BroilerHostingPackageVersion)" />
    <PackageVersion Include="Broiler.Graphics" Version="$(BroilerGraphicsPackageVersion)" />
    <PackageVersion Include="Broiler.Documents.Pdf" Version="$(BroilerDocumentsPackageVersion)" />
    <PackageVersion Include="Broiler.Graphics.Windows" Version="0.1.0-preview.12" />
    <PackageVersion Include="Broiler.Graphics.Linux" Version="0.1.0-preview.12" />
    <PackageVersion Include="Broiler.Graphics.Linux.OpenGL" Version="0.1.0-preview.12" />
    <PackageVersion Include="Broiler.Input.Keyboard" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Mouse" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Touch" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Keyboard.Windows" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Mouse.Windows" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Linux" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Keyboard.Linux" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Mouse.Linux" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.UI.Button.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.CheckBox.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.Dialog.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.FileDialog.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.Label.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.PrintDialog.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.Panel.Standard" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.RadioButton.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.Window.Standard" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="xunit" Version="2.5.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
</Project>