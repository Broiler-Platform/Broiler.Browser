<Project>
  <!--
    Central Package Management: every PackageReference under src/ names a package only, and its
    version lives here. Packages a component publishes in lock-step share a family property; a
    package pinned apart from its family keeps its own literal version.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <BroilerHtmlVersion>0.1.0-preview.27</BroilerHtmlVersion>
    <BroilerHtmlBridgeVersion>0.1.0-preview.28-http2.6</BroilerHtmlBridgeVersion>
    <BroilerUiVersion>0.1.0-preview.19</BroilerUiVersion>
    <BroilerInputVersion>0.1.0-preview.5</BroilerInputVersion>
    <BroilerGraphicsVersion>0.1.0-preview.11</BroilerGraphicsVersion>
    <BroilerHostingVersion>0.1.0-preview.8</BroilerHostingVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Broiler.HTML.Graphics" Version="0.1.0-preview.28" />
    <PackageVersion Include="Broiler.HTML.Image" Version="0.1.0-preview.28" />
    <PackageVersion Include="Broiler.HtmlBridge.Dom" Version="$(BroilerHtmlBridgeVersion)" />
    <PackageVersion Include="Broiler.HtmlBridge.Scripting" Version="$(BroilerHtmlBridgeVersion)" />
    <PackageVersion Include="Broiler.HtmlBridge.Scripting.Vm" Version="$(BroilerHtmlBridgeVersion)" />
    <PackageVersion Include="Broiler.CSS.Dom" Version="0.1.0-preview.17" />
    <PackageVersion Include="Broiler.Dom.Html" Version="0.1.0-preview.14" />
    <PackageVersion Include="Broiler.Layout" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.Net" Version="0.1.0-preview.3" />
    <PackageVersion Include="Broiler.Hosting.Windows" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Hosting.Linux" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Hosting.Android" Version="0.1.0-preview.9" />
    <PackageVersion Include="Broiler.Graphics" Version="0.1.0-preview.12" />
    <PackageVersion Include="Broiler.Graphics.Windows" Version="0.1.0-preview.12" />
    <PackageVersion Include="Broiler.Graphics.Linux" Version="0.1.0-preview.12" />
    <PackageVersion Include="Broiler.Graphics.Linux.OpenGL" Version="0.1.0-preview.12" />
    <PackageVersion Include="Broiler.Input.Keyboard" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Mouse" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Touch" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Keyboard.Windows" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Mouse.Windows" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Linux" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Keyboard.Linux" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Input.Mouse.Linux" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.UI.Button.Standard" Version="0.1.0-preview.20" />
    <PackageVersion Include="Broiler.UI.CheckBox.Standard" Version="0.1.0-preview.20" />
    <PackageVersion Include="Broiler.UI.Dialog.Standard" Version="0.1.0-preview.20" />
    <PackageVersion Include="Broiler.UI.FileDialog.Standard" Version="0.1.0-preview.20" />
    <PackageVersion Include="Broiler.UI.Label.Standard" Version="0.1.0-preview.20" />
    <PackageVersion Include="Broiler.UI.Panel.Standard" Version="$(BroilerUiVersion)" />
    <PackageVersion Include="Broiler.UI.RadioButton.Standard" Version="0.1.0-preview.20" />
    <PackageVersion Include="Broiler.UI.Window.Standard" Version="0.1.0-preview.20" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="xunit" Version="2.5.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
</Project>