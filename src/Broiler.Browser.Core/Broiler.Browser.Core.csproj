<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Browser</RootNamespace>
    <AssemblyName>Broiler.Browser.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    THE ONLY CONDITIONAL REFERENCE IN THIS REPOSITORY, AND THE REASON THE -VM CONFIGURATIONS EXIST.
    $(BroilerJavaScriptEngine) is set from the configuration name by eng/Broiler.Configurations.props
    and is `Vm` for Debug-VM and Release-VM. Under every other configuration this reference is
    absent, so nothing of Broiler.VM is restored, built or copied.

    TWO THINGS A READER SHOULD NOT INFER FROM IT.

    It does not remove Broiler.JS: Broiler.HtmlBridge.Dom binds the document to Broiler.JavaScript
    types and is reached from here through Scripting either way. What the configuration selects is
    which IScriptEngine BrowserApp instantiates — see the #if in BrowserApp.cs and
    docs/vm-javascript-profile.md.

    What it no longer does is put VM projects into the generated solutions. While this was a
    ProjectReference to a checkout, scripts/update-solutions.ps1 read it regardless of its
    Condition, so all four .slnx files listed the VM projects and built them in every
    configuration. As a PackageReference it is not a project at all: the solutions list only this
    repository's own projects, and restore honours the Condition, so a solution build under Debug
    or Release is as VM-free as a project-level one. Debug-VM and Release-VM still reach the Visual
    Studio dropdown through the `configurations` in eng/solutions.json and
    eng/Broiler.ConfigurationNames.targets.
  -->
  <ItemGroup Condition="'$(BroilerJavaScriptEngine)' == 'Vm'">
    <PackageReference Include="Broiler.HtmlBridge.Scripting.Vm" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Broiler.App\Rendering\RenderingPipeline.cs" Link="Rendering\RenderingPipeline.cs" />
    <Compile Include="..\Broiler.App\Rendering\PageLoader.cs" Link="Rendering\PageLoader.cs" />
    <Compile Include="..\Broiler.App\Rendering\PageRequest.cs" Link="Rendering\PageRequest.cs" />
    <Compile Include="..\Broiler.App\Rendering\PageLoadResult.cs" Link="Rendering\PageLoadResult.cs" />
    <Compile Include="..\Broiler.App\Rendering\IPageLoader.cs" Link="Rendering\IPageLoader.cs" />
    <Compile Include="..\Broiler.App\FavoritesManager.cs" Link="FavoritesManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.Browser.Windows" />
    <InternalsVisibleTo Include="Broiler.Browser.Linux" />
    <InternalsVisibleTo Include="Broiler.Browser.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.Browser.Android" />
  </ItemGroup>

  <!--
    src/Broiler.Browser.Cli, whose assembly keeps the Broiler.Cli name it had in the Broiler
    repository (its csproj says why). It composes a page's pipeline from the pieces the window
    uses: BrowserProfile, PageLoader's timed constructor, BrowserApp.NewScriptEngine and
    BridgeOptions, and HtmlPostProcessor.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.Cli" />
    <InternalsVisibleTo Include="Broiler.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.HTML.Graphics" />
    <PackageReference Include="Broiler.HTML.Image" />
    <PackageReference Include="Broiler.HtmlBridge.Dom" />
    <PackageReference Include="Broiler.HtmlBridge.Scripting" />
    <PackageReference Include="Broiler.Net" />
    <PackageReference Include="Broiler.Input.Keyboard" />
    <PackageReference Include="Broiler.Input.Mouse" />
    <PackageReference Include="Broiler.Input.Touch" />
    <PackageReference Include="Broiler.UI.Button.Standard" />
    <PackageReference Include="Broiler.UI.CheckBox.Standard" />
    <PackageReference Include="Broiler.UI.Dialog.Standard" />
    <PackageReference Include="Broiler.UI.FileDialog.Standard" />
    <PackageReference Include="Broiler.UI.Label.Standard" />
    <PackageReference Include="Broiler.UI.RadioButton.Standard" />
    <PackageReference Include="Broiler.UI.Window.Standard" />
  </ItemGroup>

  <!--
    THE PARSER, THE CASCADE AND THE LAYOUT ENGINE THE WINDOW RUNS ARE NAMED HERE.

    None of the references above names Broiler.Dom.Html, Broiler.CSS.Dom or Broiler.Layout.
    Broiler.HTML.* and Broiler.HtmlBridge.* bring them, and those packages declare only a minimum
    version of each. NuGet takes the lowest version that satisfies every range, so without these
    lines the window runs those minimums. A component's fix would reach it only once a package above
    was republished to ask for it: the window parsed with Broiler.Dom.Html 0.1.0-preview.8 while
    preview.9 to preview.11 were already published. Broiler.Dom and Broiler.CSS follow
    Broiler.Dom.Html and Broiler.CSS.Dom, each of which requires its own version of them.

    src/Broiler.Browser.Cli names none of these versions itself. Its page analysis asks each of them
    for a diagnostic (HtmlParseOptions.ReportParseErrors, CssSelectorMatcher.DescribeGaps,
    LayoutDiagnostics), and what it diagnoses has to be what the window runs.
  -->
  <ItemGroup>
    <PackageReference Include="Broiler.CSS.Dom" />
    <PackageReference Include="Broiler.Dom.Html" />
    <PackageReference Include="Broiler.Layout" />
  </ItemGroup>

</Project>
