    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Browser</RootNamespace>
    <AssemblyName>Broiler.Browser.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Broiler.Graphics\src\Broiler.Graphics\Broiler.Graphics.csproj" />
    <ProjectReference Include="..\..\Broiler.Media\src\Broiler.Media.Image.Managed\Broiler.Media.Image.Managed.csproj" />
    <ProjectReference Include="..\..\Broiler.Input\src\Broiler.Input\Broiler.Input.csproj" />
    <ProjectReference Include="..\..\Broiler.Input\src\Broiler.Input.Keyboard\Broiler.Input.Keyboard.csproj" />
    <ProjectReference Include="..\..\Broiler.Input\src\Broiler.Input.Mouse\Broiler.Input.Mouse.csproj" />
    <ProjectReference Include="..\..\Broiler.UI\src\Implementations\Standard\Shell\Broiler.UI.Window.Standard\Broiler.UI.Window.Standard.csproj" />
    <ProjectReference Include="..\..\Broiler.UI\src\Implementations\Standard\Shell\Broiler.UI.FileDialog.Standard\Broiler.UI.FileDialog.Standard.csproj" />
    <ProjectReference Include="..\..\Broiler.UI\src\Implementations\Standard\Shell\Broiler.UI.Dialog.Standard\Broiler.UI.Dialog.Standard.csproj" />
    <ProjectReference Include="..\..\Broiler.UI\src\Implementations\Standard\Layout\Broiler.UI.Panel.Standard\Broiler.UI.Panel.Standard.csproj" />
    <ProjectReference Include="..\..\Broiler.UI\src\Implementations\Standard\Content\Broiler.UI.Label.Standard\Broiler.UI.Label.Standard.csproj" />
    <ProjectReference Include="..\..\Broiler.UI\src\Implementations\Standard\Commands\Broiler.UI.Button.Standard\Broiler.UI.Button.Standard.csproj" />
    <ProjectReference Include="..\..\Broiler.UI\src\Implementations\Standard\Text\Broiler.UI.Edit.Standard\Broiler.UI.Edit.Standard.csproj" />
    <ProjectReference Include="..\..\Broiler.UI\src\Implementations\Standard\ValueAndSelection\Broiler.UI.CheckBox.Standard\Broiler.UI.CheckBox.Standard.csproj" />
    <ProjectReference Include="..\..\Broiler.UI\src\Implementations\Standard\ValueAndSelection\Broiler.UI.ComboBox.Standard\Broiler.UI.ComboBox.Standard.csproj" />
    <ProjectReference Include="..\..\Broiler.UI\src\Implementations\Standard\ValueAndSelection\Broiler.UI.ListView.Standard\Broiler.UI.ListView.Standard.csproj" />
    <ProjectReference Include="..\..\Broiler.UI\src\Implementations\Standard\ValueAndSelection\Broiler.UI.RadioButton.Standard\Broiler.UI.RadioButton.Standard.csproj" />
    <ProjectReference Include="..\..\Broiler.UI\src\Abstractions\Commands\Broiler.UI.Toolbar\Broiler.UI.Toolbar.csproj" />
    <ProjectReference Include="..\..\Broiler.UI\src\Implementations\Standard\Commands\Broiler.UI.Toolbar.Standard\Broiler.UI.Toolbar.Standard.csproj" />
    <ProjectReference Include="..\..\Broiler.HTML\Source\Broiler.HTML.Graphics\Broiler.HTML.Graphics.csproj" />
    <ProjectReference Include="..\..\Broiler.DOM\Broiler.Dom\Broiler.Dom.csproj" />
    <ProjectReference Include="..\..\Broiler.DOM\Broiler.Dom.Html\Broiler.Dom.Html.csproj" />
    <ProjectReference Include="..\..\Broiler.JS\Broiler.JS\Broiler.JavaScript.All\Broiler.JavaScript.All.csproj" />
    <ProjectReference Include="..\Broiler.HtmlBridge.Scripting\Broiler.HtmlBridge.Scripting.csproj" />
  </ItemGroup>

  <!--
    THE ONLY CONDITIONAL REFERENCE IN THIS REPOSITORY, AND THE REASON THE -VM CONFIGURATIONS EXIST.
    $(BroilerJavaScriptEngine) is set from the configuration name by eng/Broiler.Configurations.props
    and is `Vm` for Debug-VM and Release-VM. Under every other configuration this reference is
    absent, so nothing of Broiler.VM is restored, built or copied.

    TWO THINGS A READER SHOULD NOT INFER FROM IT.

    It does not remove Broiler.JS: Broiler.HtmlBridge.Dom binds the document to Broiler.JavaScript
    types and is reached from here through Scripting either way. What the configuration selects is
    which IScriptEngine BrowserApp instantiates — see the #if in BrowserApp.cs and
    docs/vm-javascript-profile.md.

    And it does not make the VM projects disappear from the generated solutions.
    scripts/update-solutions.ps1 reads every ProjectReference regardless of its Condition, so all
    four .slnx files list them and build them in all four configurations. That is deliberate: a
    solution has to carry the union to offer the configuration in the Visual Studio dropdown at
    all. A project-level build is the one that is genuinely VM-free under Debug and Release.
  -->
  <ItemGroup Condition="'$(BroilerJavaScriptEngine)' == 'Vm'">
    <ProjectReference Include="..\Broiler.HtmlBridge.Scripting.Vm\Broiler.HtmlBridge.Scripting.Vm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Broiler.App\Rendering\RenderingPipeline.cs" Link="Rendering\RenderingPipeline.cs" />
    <Compile Include="..\Broiler.App\Rendering\PageLoader.cs" Link="Rendering\PageLoader.cs" />
    <Compile Include="..\Broiler.App\Rendering\PageRequest.cs" Link="Rendering\PageRequest.cs" />
    <Compile Include="..\Broiler.App\Rendering\IPageLoader.cs" Link="Rendering\IPageLoader.cs" />
    <Compile Include="..\Broiler.App\FavoritesManager.cs" Link="FavoritesManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.Browser.Windows" />
    <InternalsVisibleTo Include="Broiler.Browser.Linux" />
    <InternalsVisibleTo Include="Broiler.Browser.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.Browser.Android" />
  </ItemGroup>

</Project>
