<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Broiler.Browser.Core.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Browser.Core\Broiler.Browser.Core.csproj" />
  </ItemGroup>

  <!--
    The same conditional reference Broiler.Browser.Core carries, for the same reason and with the
    same effect on the generated solutions. Without it VmScriptEngineTests could not name the type
    it tests, and the -VM configurations would be gated on nothing but whether they compile.
  -->
  <ItemGroup Condition="'$(BroilerJavaScriptEngine)' == 'Vm'">
    <ProjectReference Include="..\Broiler.HtmlBridge.Scripting.Vm\Broiler.HtmlBridge.Scripting.Vm.csproj" />
  </ItemGroup>

  <!--
    THE JSEAL CONFORMANCE SUITE NAMES NO ENGINE TYPE, which is what makes it a conformance suite and
    what stops it loading a provider assembly on its own. JsEngineHosting.EnsureRegistered names the
    Broiler.JS provider, and it cannot name this one: Broiler.HtmlBridge.Scripting is linked in every
    configuration and this provider is linked in two, so a reference from there would drag Broiler.VM
    into every build. So the naming happens here, in the assembly that already knows which
    configuration it is, under the same condition as the reference above.
  -->
  <ItemGroup>
    <Compile Remove="Jseal\VmProviderRegistration.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(BroilerJavaScriptEngine)' == 'Vm'">
    <Compile Include="Jseal\VmProviderRegistration.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
