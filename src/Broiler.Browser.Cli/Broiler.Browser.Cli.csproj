<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Cli</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    THE ASSEMBLY KEEPS THE NAME IT HAD IN THE BROILER REPOSITORY, AND NOT FOR NOSTALGIA.

    This is src/Broiler.Cli from Broiler-Platform/Broiler, which stayed behind there when the
    browser moved out. Two things are keyed on the assembly name rather than the project name.

    The executable is called Broiler.Cli, and every script, test page and note that drives it
    spells it that way.

    And the components it reaches below the public surface still grant their internals to it by
    that name. Broiler.HtmlBridge.Core, .Dom and .Scripting all carry
    [InternalsVisibleTo("Broiler.Cli")] and [InternalsVisibleTo("Broiler.Cli.Tests")] in the
    published packages, which is how a capture reaches ResourceTrace for its diagnostics bundle and
    the page realm's DomBridge.Realm for evaluate-page. None of those assemblies is strong-named,
    so the name alone is the grant. Renaming the assembly would take the grants away.
  -->
  <PropertyGroup>
    <AssemblyName>Broiler.Cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.Cli.Tests" />
  </ItemGroup>

  <!--
    Everything else arrives through Broiler.Browser.Core: the page is loaded, its scripts run and
    its load window settles in the code the window uses, and the packages that code needs
    (Broiler.HtmlBridge.*, Broiler.HTML.Image, Broiler.Net) come with it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Broiler.Browser.Core\Broiler.Browser.Core.csproj" />
  </ItemGroup>

  <!--
    Three components are referenced directly although Broiler.Browser.Core brings them anyway: the page analysis
    asks each for a diagnostic the window never needs, so this project names the version whose API it
    uses rather than inheriting whatever version Core's dependencies settle on. Broiler.Dom.Html
    reports parse errors (HtmlParseOptions.ReportParseErrors), Broiler.Layout reports the CSS it does
    not apply as written (LayoutDiagnostics), and Broiler.CSS.Dom says which selectors the cascade
    guesses at (CssSelectorMatcher.DescribeGaps).
  -->
  <ItemGroup>
    <PackageReference Include="Broiler.CSS.Dom" Version="0.1.0-preview.8" />
    <PackageReference Include="Broiler.Dom.Html" Version="0.1.0-preview.9" />
    <PackageReference Include="Broiler.Layout" Version="0.1.0-preview.7" />
  </ItemGroup>

</Project>
