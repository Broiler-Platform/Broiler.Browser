<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Browser</RootNamespace>
    <AssemblyName>Broiler.Browser.Windows</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Windows;Release-Windows;Debug-VM;Release-VM</Configurations>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug-Windows' Or '$(Configuration)' == 'Release-Windows'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- The Win32 clipboard, shared with the other desktop heads. -->
  <ItemGroup>
    <Compile Include="..\Broiler.App\WindowsClipboard.cs" Link="WindowsClipboard.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Broiler.Graphics.Windows" Version="0.1.0-preview.3" />
    <PackageReference Include="Broiler.Input.Keyboard.Windows" Version="0.1.0-preview.2" />
    <PackageReference Include="Broiler.Input.Mouse.Windows" Version="0.1.0-preview.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Browser.Core\Broiler.Browser.Core.csproj" />
  </ItemGroup>

</Project>
