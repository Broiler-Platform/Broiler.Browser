<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Browser</RootNamespace>
    <AssemblyName>Broiler.Browser.Windows</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Windows;Release-Windows;Debug-VM;Release-VM</Configurations>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug-Windows' Or '$(Configuration)' == 'Release-Windows'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    Startup and steady-state speed. A release publish for a runtime (Release-Windows, or any
    Release with a runtime identifier) is ReadyToRun: precompiled, so the process starts on native
    code instead of JIT-compiling everything it touches. Measured on the offscreen head with a
    script-driven page: 1.46 s instead of 2.11 s to finish, first render 62 ms instead of 273 ms,
    for an executable 31 MB larger. Tiered compilation with dynamic PGO then recompiles the hot
    methods with what the running page does; both are .NET's defaults, stated so they stay on.
    Not NativeAOT and not trimmed: Broiler.JS reflects over members the trimmer removes (see
    .github/workflows/release.yml).
  -->
  <PropertyGroup>
    <PublishReadyToRun Condition="('$(Configuration)' == 'Release' Or '$(BroilerBaseConfiguration)' == 'Release') And '$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- The Win32 clipboard, shared with the other desktop heads. -->
  <ItemGroup>
    <Compile Include="..\Broiler.App\WindowsClipboard.cs" Link="WindowsClipboard.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Broiler.Graphics.Windows" Version="0.1.0-preview.7" />
    <PackageReference Include="Broiler.Input.Keyboard.Windows" Version="0.1.0-preview.5" />
    <PackageReference Include="Broiler.Input.Mouse.Windows" Version="0.1.0-preview.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Browser.Core\Broiler.Browser.Core.csproj" />
  </ItemGroup>

</Project>
