<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Browser.Android</RootNamespace>
    <AssemblyName>Broiler.Browser.Android</AssemblyName>
    <ApplicationId>org.broiler.browser</ApplicationId>
    <ApplicationTitle>Broiler Browser</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- The versionName users see, from BroilerBrowserVersion (Directory.Build.props). The
         versionCode above is 1 for a local build; the Release workflow passes the preview number. -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- The ABI set, overridable for a single-ABI package (the preview package's arm64 APK).
         It goes through a Broiler-owned property rather than passing RuntimeIdentifiers itself on
         the command line: that would be an MSBuild global property, so it would reach every
         referenced net10.0 library too, and a library restored without it fails NETSDK1047 asking
         for a 'net10.0/android-arm64' target it has no reason to have. Only this head reads
         BroilerAndroidAbis, so the override lands where it means something. -->
    <BroilerAndroidAbis Condition="'$(BroilerAndroidAbis)' == ''">android-arm64;android-x64</BroilerAndroidAbis>
    <RuntimeIdentifiers>$(BroilerAndroidAbis)</RuntimeIdentifiers>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- A release package is AOT-compiled with the SDK's startup profile (profiled AOT), .NET for
         Android's recommended release setting: the methods startup runs are native in the package,
         the rest stays JIT. AOT requires trimming (XA1030), and it is trimmed in partial mode on
         purpose: the framework is trimmed, every other assembly is kept whole. Broiler.JS reflects
         over its own members, and full trimming removes them (a NativeAOT desktop build dies in
         JSObjectBuilder before Main). Debug builds stay JIT-only and untrimmed. -->
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release' Or '$(BroilerBaseConfiguration)' == 'Release'">true</RunAOTCompilation>
    <RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">false</RunAOTCompilation>
    <AndroidEnableProfiledAot Condition="'$(RunAOTCompilation)' == 'true'">true</AndroidEnableProfiledAot>
    <PublishTrimmed Condition="'$(RunAOTCompilation)' == 'true'">true</PublishTrimmed>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">false</PublishTrimmed>
    <TrimMode Condition="'$(PublishTrimmed)' == 'true'">partial</TrimMode>
    <!-- The package format follows the BASE configuration, not the literal name. Keying it on
         '$(Configuration)' == 'Release' alone was correct while Release was the only release-like
         configuration this head built; Release-VM is a second one, and it would have produced a
         debuggable .apk from a release build with nothing said about it. $(BroilerBaseConfiguration)
         (eng/Broiler.Configurations.props) is empty for the plain names, so both tests are needed
         and Release keeps answering exactly as it did. -->
    <AndroidPackageFormat Condition="'$(Configuration)' == 'Release' Or '$(BroilerBaseConfiguration)' == 'Release'">aab</AndroidPackageFormat>
    <AndroidPackageFormat Condition="'$(AndroidPackageFormat)' == ''">apk</AndroidPackageFormat>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-VM;Release-VM</Configurations>
  </PropertyGroup>

  <!--
    Partial trimming keeps every assembly whole EXCEPT one that declares itself trimmable, and
    Broiler.JavaScript.Expressions does (IsTrimmable and IsAotCompatible in Broiler.JS) without
    being so: Broiler.JS's compiler builds expressions that name its members as strings, such as
    Box<T>.Value in GeneratorRewriter.AddScriptInfoCapture. Trimmed, that lookup finds nothing,
    BFieldExpression's constructor throws a NullReferenceException, and every page with a script
    fails to load with "Object reference not set to an instance of an object" (seen on the API 36
    emulator). Rooted, it stays whole. Remove this once Broiler.JS drops the claim; the other
    trimmable-declaring Broiler assemblies (Graphics, Media, Native) are trimmed as they ask.
  -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="Broiler.JavaScript.Expressions" RootMode="All" />
  </ItemGroup>

  <!-- The view, canvas renderer and input coordinator the activity hosts the browser in. -->
  <ItemGroup>
    <PackageReference Include="Broiler.Hosting.Android" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Browser.Core\Broiler.Browser.Core.csproj" />
  </ItemGroup>

</Project>
