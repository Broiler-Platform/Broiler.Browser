<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Browser</RootNamespace>
    <AssemblyName>Broiler.Browser.Linux</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Linux;Release-Linux;Debug-VM;Release-VM</Configurations>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug-Linux' Or '$(Configuration)' == 'Release-Linux'">linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Broiler.App\LinuxInputCoordinator.cs" Link="LinuxInputCoordinator.cs" />
    <Compile Include="..\Broiler.App\LinuxX11Clipboard.cs" Link="LinuxX11Clipboard.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Graphics.Linux" Version="0.1.0-preview.3" />
    <PackageReference Include="Broiler.Graphics.Linux.OpenGL" Version="0.1.0-preview.3" />
    <PackageReference Include="Broiler.Input.Keyboard.Linux" Version="0.1.0-preview.2" />
    <PackageReference Include="Broiler.Input.Linux" Version="0.1.0-preview.2" />
    <PackageReference Include="Broiler.Input.Mouse.Linux" Version="0.1.0-preview.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Browser.Core\Broiler.Browser.Core.csproj" />
  </ItemGroup>

</Project>
